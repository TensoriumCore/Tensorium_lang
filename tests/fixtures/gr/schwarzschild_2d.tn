# Schwarzschild-like kernel in 2D (semantic regression fixture)
field scalar alpha
field scalar phi
field scalar H
field cov_tensor2 gamma[i,j]
field con_tensor2 gammaU[i,j]
field cov_tensor2 K[i,j]

simulation {
  coordinates = spherical
  dimension = 2
  resolution = [64,64]

  time {
    dt = 0.001
    integrator = rk3
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

evolution Schwarzschild2D {
  dt H = contract(gammaU[i,j] * d_i(d_j(phi)))
  dt K[i,j] = d_i(d_j(phi)) + alpha * gamma[i,j]
}
