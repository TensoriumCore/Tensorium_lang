# End-to-end radial CTT solve followed by Cartesian BSSN initialization.
field scalar chi
field cov_tensor2 gamma[i,j]
field con_tensor2 gammaU[i,j]
field cov_tensor2 Atilde[i,j]
field scalar K
field scalar alpha

params { amplitude }

simulation {
  coordinates = cartesian
  dimension = 3
  resolution = [5,5,5]

  time {
    dt = 0.01
    integrator = rk4
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

initial_data CttBssnHandoff {
  domain inner_shell {
    coordinates = spherical
    topology = shell
    resolution = [25]
    basis = chebyshev
    bounds = [1, 2]
  }

  domain outer_shell {
    coordinates = spherical
    topology = shell
    resolution = [25]
    basis = chebyshev
    bounds = [2, 4]
  }

  interface inner_shell -> outer_shell

  unknown scalar psi
  unknown scalar w

  equation scalar hamiltonian =
      laplacian(psi)
      + (1 / 3) * (radial_derivative(w) - w / r)^2 * psi^(-7)
      - (3 / 4) * amplitude^2 * r^(-3) * psi^5

  equation scalar momentum =
      radial_conformal_vector_laplacian(w)
      + 3 * amplitude * r^(-2.5) * psi^6

  boundary inner {
    psi = 1
    w = amplitude
  }

  boundary outer {
    psi = 1
    w = amplitude / 2
  }

  seed psi = 0.8
  seed w = 0.75 * amplitude * r^(-0.5)

  reconstruct ctt {
    conformal_factor = psi
    radial_vector = w
    mean_curvature = 3 * amplitude * r^(-1.5)
  }

  solve {
    nonlinear = newton
    linear = direct
    tolerance = 1e-11
    max_iterations = 15
  }
}

# Zero-shift BSSN evolution terms used to prove that the generated RHS reads
# the buffers initialized by the constraint solve.
evolution BssnHandoff {
  dt chi = (2 / 3) * alpha * chi * K
  dt gamma[i,j] = -2 * alpha * Atilde[i,j]
}
