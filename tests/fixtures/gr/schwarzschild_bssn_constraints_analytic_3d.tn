# Schwarzschild time-symmetric slice with a complete analytic BSSN RHS surface
# and ADM constraints.
#
# The metric is the standard t = const Schwarzschild spatial metric in
# spherical coordinates:
#   gamma_ij = diag(1/f, r^2, r^2 sin(theta)^2), f = 1 - 2M/r
#
# The BSSN state is the static zero-shift, time-symmetric reduction:
#   chi = 1
#   beta^i = 0
#   B^i = 0
#   K = 0
#   gammatilde_ij = gamma_ij
#   gammatilde^ij = gamma^ij
#   Atilde_ij = 0
#   Gammahat^i = 0
#
# The analytic 3D spatial Ricci tensor is represented without calling sin()
# in the RHS:
#   R_ij = (M/r^3) gamma_ij - (3M/(r^3 f)) radialBasis_ij
#
# The static-vacuum identity D_i D_j alpha = alpha R_ij is encoded
# analytically. Therefore the BSSN RHS and constraints vanish:
#   dchi = dalpha = dbeta^i = dB^i = dK = 0
#   dgammatilde_ij = dAtilde_ij = dGammahat^i = 0
#   Hamiltonian = gammaU^ij R_ij + K^2 - A_ij A^ij = 0
#   Momentum_i = D_j A^j_i - 2/3 d_i K = 0


field metric g[mu,nu]
field inverse_metric gU[mu,nu]
field scalar alpha
field cov_tensor2 gamma[i,j]
field con_tensor2 gammaU[i,j]

field scalar chi
field vector beta[i]
field vector B[i]
field scalar K
field cov_tensor2 gammatilde[i,j]
field con_tensor2 gammatildeU[i,j]
field cov_tensor2 Atilde[i,j]
field vector Gammahat[i]

field scalar Rcoord
field cov_tensor2 radialBasis[i,j]

field scalar dchi
field scalar dalpha
field vector dbeta[i]
field vector dB[i]
field scalar dK
field cov_tensor2 dgammatilde[i,j]
field cov_tensor2 dAtilde[i,j]
field vector dGammahat[i]

field cov_tensor2 RicciAnalytic[i,j]
field cov_tensor2 HessianAlpha[i,j]
field cov_tensor3 DAtilde[i,j,k]
field scalar Hamiltonian
field covector Momentum[i]

params { M, eta }

simulation {
  coordinates = spherical
  dimension = 3
  resolution = [5,5,5]

  time {
    dt = 0.001
    integrator = euler
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

initial_data {
  enforce_symmetry = true

  metric4 g[mu,nu] = [
    [-(1 - 2*M/r), 0, 0, 0],
    [0, 1/(1 - 2*M/r), 0, 0],
    [0, 0, r*r, 0],
    [0, 0, 0, r*r*sin(theta)*sin(theta)]
  ]

  split_3p1 {
    alpha -> alpha;
    gamma -> gamma[i,j];
    gammaU -> gammaU[i,j];
  }
}

evolution SchwarzschildBSSNFullConstraintsAnalytic {
  f = 1.0 - 2.0*M/Rcoord

  AnalyticRicci[i,j] =
      (M/(Rcoord*Rcoord*Rcoord)) * gamma[i,j]
    - ((3.0*M)/(Rcoord*Rcoord*Rcoord*f)) * radialBasis[i,j]

  AnalyticHessianAlpha[i,j] = alpha * AnalyticRicci[i,j]

  DAtildeAnalytic[i,j,k] = nabla_k(Atilde[i,j])

  AtildeSq =
      contract(Atilde[i,j] * gammatildeU[i,k] * gammatildeU[j,l] * Atilde[k,l])

  RicciScalar = chi * contract(gammatildeU[i,j] * AnalyticRicci[i,j])

  LaplacianAlpha =
      chi * contract(gammatildeU[i,j] * AnalyticHessianAlpha[i,j])

  AtildeTraceFreeSource[i,j] =
      (-1.0) * AnalyticHessianAlpha[i,j] + alpha * AnalyticRicci[i,j]

  AtildeTrace =
      contract(gammatildeU[i,j] * AtildeTraceFreeSource[i,j])

  MetricZero[i,j] = gammatilde[i,j] - gammatilde[i,j]

  GammaDriver[i] = Gammahat[i] - Gammahat[i]

  BetaZero = contract(beta[i] * Gammahat[i])

  dt dchi = (2.0/3.0) * alpha * chi * K + BetaZero

  dt dalpha = -2.0 * alpha * K + BetaZero

  dt dbeta[i] = B[i]

  dt dB[i] = (3.0/4.0) * GammaDriver[i] - eta * B[i]

  dt dK =
      -LaplacianAlpha
    + alpha * (RicciScalar + AtildeSq + (1.0/3.0) * K*K)

  dt dgammatilde[i,j] = -2.0 * alpha * Atilde[i,j] + MetricZero[i,j]

  dt dAtilde[i,j] =
      AtildeTraceFreeSource[i,j]
    - (1.0/3.0) * gammatilde[i,j] * AtildeTrace
    + alpha * K * Atilde[i,j]
    - 2.0 * alpha * contract(Atilde[i,k] * gammatildeU[k,l] * Atilde[l,j])

  dt dGammahat[i] = GammaDriver[i]


  dt RicciAnalytic[i,j] = AnalyticRicci[i,j]

  dt HessianAlpha[i,j] = AnalyticHessianAlpha[i,j]

  dt DAtilde[i,j,k] = DAtildeAnalytic[i,j,k]

  dt Hamiltonian =
      RicciScalar
    + K*K
    - AtildeSq

  dt Momentum[i] =
      contract(gammaU[j,k] * DAtildeAnalytic[i,j,k])
    - (2.0/3.0) * d_i(K)
}
