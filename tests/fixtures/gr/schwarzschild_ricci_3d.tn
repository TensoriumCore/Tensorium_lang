# Schwarzschild 3D spatial Ricci fixture built from the 3+1 spatial metric.
# This computes the Ricci tensor of gamma_ij, not the 4D vacuum Ricci tensor.
field metric g[mu,nu]
field inverse_metric gU[mu,nu]
field scalar alpha
field cov_tensor2 gamma[i,j]
field con_tensor2 gammaU[i,j]
field cov_tensor2 Ricci[i,j]

params { M }

simulation {
  coordinates = spherical
  dimension = 3
  resolution = [24,24,24]

  time {
    dt = 0.001
    integrator = rk3
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 4
  }
}

initial_data {
  enforce_symmetry = true
  metric4 g[mu,nu] = [
    [-(1 - 2*M/r), 0, 0, 0],
    [0, 1/(1 - 2*M/r), 0, 0],
    [0, 0, r*r, 0],
    [0, 0, 0, r*r*sin(theta)*sin(theta)]
  ]
  split_3p1 {
    alpha -> alpha;
    gamma -> gamma[i,j];
    gammaU -> gammaU[i,j];
  }
}

evolution SchwarzschildRicci {
  Christoffel[i,j,k] = christoffel(gamma, gammaU)
  dt Ricci[i,j] =
      contract(d_k(Christoffel[k,i,j]))
    - contract(d_j(Christoffel[k,i,k]))
    + contract(Christoffel[k,i,j] * Christoffel[l,k,l])
    - contract(Christoffel[k,i,l] * Christoffel[l,j,k])
}
