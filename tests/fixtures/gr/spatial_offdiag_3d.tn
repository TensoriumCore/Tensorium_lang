# Symmetric spatial off-diagonal metric fixture (numeric init regression)
field metric g[mu,nu]
field inverse_metric gU[mu,nu]
field scalar alpha
field scalar phi
field scalar H
field cov_tensor2 gamma[i,j]
field con_tensor2 gammaU[i,j]
field cov_tensor2 K[i,j]

simulation {
  coordinates = cartesian
  dimension = 3
  resolution = [8,8,8]

  time {
    dt = 0.001
    integrator = rk3
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

initial_data {
  enforce_symmetry = true
  metric4 g[mu,nu] = [
    [-1, 0, 0, 0],
    [0, 2, 1, 0],
    [0, 1, 3, 0],
    [0, 0, 0, 4]
  ]
  split_3p1 {
    alpha -> alpha;
    gamma -> gamma[i,j];
    gammaU -> gammaU[i,j];
  }
}

evolution SpatialOffDiag3D {
  dt H = contract(gammaU[i,j] * d_i(d_j(phi)))
  dt K[i,j] = d_i(d_j(phi)) + alpha * gamma[i,j]
}

