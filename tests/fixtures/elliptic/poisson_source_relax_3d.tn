# Poisson relaxation with a runtime-provided source field.
#
# The host runner initializes source so that a sine mode is the exact solution
# of the second-order discrete Laplacian on the test grid:
#   laplacian(u_exact) + source = 0
field scalar u
field scalar v
field scalar source
field scalar H
field scalar du
field scalar dv

params { c, eta }

simulation {
  coordinates = cartesian
  dimension = 3
  resolution = [16,16,16]

  time {
    dt = 0.02
    integrator = euler
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

constraints PoissonSourceRelax3D {
  Hlocal = laplacian(u) + source

  residual H = Hlocal
  residual du = v - eta * u
  residual dv = c * c * Hlocal
}
