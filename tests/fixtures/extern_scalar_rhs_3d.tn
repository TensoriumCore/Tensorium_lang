extern scalar heat_source(scalar)

field scalar phi
field scalar rhs

simulation {
  dimension = 3
  resolution = [8,8,8]

  time {
    dt = 0.1
    integrator = rk4
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

evolution ExternScalarRHS {
  dt rhs = heat_source(phi)
}
