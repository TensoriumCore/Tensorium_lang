field con_tensor2 A[i,j]
field cov_tensor2 B[i,j]
field con_tensor2 C[i,j]
field con_tensor2 R[i,j]

simulation {
  dimension = 2
  resolution = [8,8]
  time { dt = 0.1 integrator = euler }
  spatial { scheme = fd derivative = centered order = 2 }
}

evolution EinsteinTwoSums {
  dt R[i,j] = contract(A[i,k] * B[k,l] * C[l,j])
}
