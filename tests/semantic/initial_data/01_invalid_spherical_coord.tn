field metric g[mu,nu]

simulation {
  coordinates = spherical
  dimension = 3
  resolution = [16,16,16]

  time {
    dt = 0.01
    integrator = rk3
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

initial_data {
  metric4 g[mu,nu] = [
    [-(1 - 2*M/x), 0, 0, 0],
    [0, 1/(1 - 2*M/r), 0, 0],
    [0, 0, r*r, 0],
    [0, 0, 0, r*r*sin(theta)*sin(theta)]
  ]
}
