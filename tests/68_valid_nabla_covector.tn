field covector W[i]
field cov_tensor2 dW[i,j]
field metric gamma[i,j]
field inverse_metric gammaU[i,j]

simulation {
  dimension = 2
  resolution = [8,8]

  time {
    dt = 0.1
    integrator = euler
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

evolution NablaCovector {
  dt dW[i,j] = nabla_j(W[i])
}
