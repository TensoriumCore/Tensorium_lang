field vector V[i]
field cov_tensor2 T[i,j]
field inverse_metric gammaU[i,j]

simulation {
  dimension = 2
  resolution = [8,8]

  time {
    dt = 0.1
    integrator = euler
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

evolution MissingMetricForNabla {
  dt T[i,j] = nabla_j(V[i])
}
