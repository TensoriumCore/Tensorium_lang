field mixed_tensor(up=1,down=1) A[i,j]
field mixed_tensor(up=2,down=1) dA[i,j,k]
field metric gamma[i,j]
field inverse_metric gammaU[i,j]

simulation {
  dimension = 2
  resolution = [8,8]

  time {
    dt = 0.1
    integrator = euler
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

evolution NablaContravariantMixed {
  dt dA[i,j,k] = nabla^k(A[i,j])
}
