field vector V[i]
field con_tensor2 dV[i,j]
field metric gamma[i,j]
field inverse_metric gammaU[i,j]

simulation {
  dimension = 2
  resolution = [8,8]

  time {
    dt = 0.1
    integrator = euler
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}

evolution NablaContravariantVector {
  dt dV[i,j] = nabla^j(V[i])
}
