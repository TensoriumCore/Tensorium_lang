
field vector V[i]
field mixed_tensor(up=1,down=1) T[i,j]
field metric gamma[i,j]
field inverse_metric gammaU[i,j]
simulation {
  dimension = 2
  resolution = [8,8]

  time {
    dt = 0.1
    integrator = euler
  }

  spatial {
    scheme = fd
    derivative = centered
    order = 2
  }
}



evolution CheckVectorNabla {
  dt T[i,j] = nabla_j(V[i])
}
